<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121421">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavigationView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_title_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hồ sơ cá nhân"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.cardview.widget.CardView
                android:id="@+id/card_account_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="#1E1A3A"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/tv_title_profile">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <FrameLayout
                        android:id="@+id/avatar_container"
                        android:layout_width="90dp"
                        android:layout_height="90dp">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="45dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#1E1A3A"> <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_gradient_button" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="T"
                                android:textColor="#FFFFFF"
                                android:textSize="32sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/img_profile_avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:clickable="true"
                                android:focusable="true"
                                android:contentDescription="Ảnh đại diện của người dùng"/>
                        </FrameLayout>
                        </androidx.cardview.widget.CardView>

                        <ImageView
                            android:id="@+id/btn_change_avatar"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:background="@android:drawable/presence_online" android:backgroundTint="#252149"
                            android:padding="6dp"
                            android:src="@android:drawable/ic_menu_camera"
                            app:tint="#FFFFFF" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_user_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="khách"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_user_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="thanhngoc200501@gmail.com"
                        android:textColor="#80FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_input_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#1E1A3A"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/card_account_info">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tên hiển thị" android:textColor="#B3FFFFFF" android:textSize="13sp" />
                    <EditText android:id="@+id/edt_display_name" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_edittext_dark" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textSize="14sp" android:hint="Nhập tên hiển thị..." android:textColorHint="#4DFFFFFF" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chiều cao (cm)" android:textColor="#B3FFFFFF" android:textSize="13sp" />
                    <EditText android:id="@+id/edt_height" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_edittext_dark" android:inputType="number" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textSize="14sp" android:hint="Ví dụ: 165" android:textColorHint="#4DFFFFFF" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cân nặng (kg)" android:textColor="#B3FFFFFF" android:textSize="13sp" />
                    <EditText android:id="@+id/edt_weight" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_edittext_dark" android:inputType="numberDecimal" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textSize="14sp" android:hint="Ví dụ: 55.5" android:textColorHint="#4DFFFFFF" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tuổi" android:textColor="#B3FFFFFF" android:textSize="13sp" />
                    <EditText android:id="@+id/edt_age" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_edittext_dark" android:inputType="number" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:textSize="14sp" android:hint="Nhập tuổi của bạn..." android:textColorHint="#4DFFFFFF" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Giới tính" android:textColor="#B3FFFFFF" android:textSize="13sp" />
                    <Spinner android:id="@+id/spinner_gender" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:layout_marginBottom="16dp" android:background="@drawable/bg_edittext_dark" android:popupBackground="#1E1A3A" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tần suất vận động" android:textColor="#B3FFFFFF" android:textSize="13sp" />
                    <Spinner android:id="@+id/spinner_activity" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:layout_marginBottom="24dp" android:background="@drawable/bg_edittext_dark" android:popupBackground="#1E1A3A" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_profile"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:background="@drawable/bg_gradient_button"
                        android:text="Lưu thông tin cá nhân"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="#252149"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintTop_toBottomOf="@id/card_input_form">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Phân tích thể trạng của bạn"
                        android:textColor="#FFEB3B"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_res_bmi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BMI: --"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tv_res_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Trạng thái: --"
                                android:textColor="#9795B4"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_res_tdee"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TDEE: -- kcal"
                                android:textColor="#FFFFFF"
                                android:textSize="18sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tv_res_target_calories"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mục tiêu: -- kcal"
                                android:textColor="#00E676"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:text="Đăng xuất tài khoản"
                android:textColor="#FF5252"
                app:strokeColor="#FF5252"
                app:strokeWidth="1.5dp"
                app:cornerRadius="24dp"
                app:layout_constraintTop_toBottomOf="@id/card_result"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/bg_main_purple"
        app:itemIconTint="#A099B0"
        app:itemTextColor="#A099B0"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>